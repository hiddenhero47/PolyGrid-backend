# Copy this to .env.test and fill in real values before running `npm test`.
# .env.test is preferred over .env so tests never touch your dev/prod DB —
# see tests/setup/env.ts.

# Optional — if unset, tests/setup/globalSetup.ts spins up a disposable
# in-memory MongoDB replica set automatically and tears it down afterwards.
# Set this to point at your own replica set instead (recommended for CI, or
# to match your real cluster's version/config exactly). Use a dedicated
# database — tests wipe every collection between tests.
TEST_MONGO_URI=

# Same secrets your real .env uses — tests sign/verify real tokens with these.
JWT_SECRET=test-jwt-secret
JWT_EMAIL_SECRET=test-jwt-email-secret

APP_NAME=PolyGrid
FRONTEND_URL=http://localhost:5173
