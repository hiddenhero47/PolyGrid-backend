# Copy this to .env.test and fill in real values before running `npm test`.
# .env.test is preferred over .env so tests never touch your dev/prod DB —
# see tests/setup/env.ts.

# Optional — if unset, tests/setup/globalSetup.ts spins up a disposable
# in-memory MongoDB replica set automatically and tears it down afterwards.
# Set this to point at your own replica set instead (recommended for CI, or
# to match your real cluster's version/config exactly). Use a dedicated
# database — tests wipe every collection between tests.
TEST_MONGO_URI=

# Same secrets your real .env uses — tests sign/verify real tokens with these.
JWT_SECRET=test-jwt-secret
JWT_EMAIL_SECRET=test-jwt-email-secret
FILE_SIGNING_SECRET=test-file-signing-secret

APP_NAME=PolyGrid
FRONTEND_URL=http://localhost:5173
BASE_URL=http://localhost:4000

# Not exercised by the test suite — Google/Apple OAuth login is deliberately
# untested here (real third-party calls, see tests/README.md), but these
# just need to be non-empty so the code that reads them behaves normally.
GOOGLE_CLIENT_ID=test-google-client-id
APPLE_CLIENT_ID=test-apple-client-id

# Uploaded test files are written here instead of ./storage, and removed by
# tests/setup/globalTeardown.ts after the whole run.
STORAGE_ROOT=storage-test

PLATFORM_FEE_PERCENT=5

# Must be non-empty (the SDK throws on construction otherwise) but doesn't
# need to be real for webhook signature tests — those are fully local/
# offline. payment.test.ts's live create/retrieve-intent tests only run
# when this is a real sk_test_... key (not this placeholder) — put your
# real key directly in .env.test (gitignored), never here.
STRIPE_SECRET_KEY=sk_test_placeholder
# Doesn't need to be a real Stripe-issued value for tests — the test suite
# signs synthetic webhook payloads with this exact string via Stripe's own
# stripe.webhooks.generateTestHeaderString, and our code verifies against
# it, so any non-empty string works.
STRIPE_WEBHOOK_SECRET=test-webhook-secret
