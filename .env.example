# Copy this to .env and fill in real values.

NODE_ENV=development
PORT=4000
MONGO_URI=
BASE_URL=http://localhost:4000

JWT_SECRET=
JWT_EMAIL_SECRET=
# Signs the short-lived ?token= on /private/view|download URLs — kept
# separate from JWT_SECRET so a leaked one can't forge a login session.
FILE_SIGNING_SECRET=

APP_NAME=PolyGrid
FRONTEND_URL=http://localhost:5173

# Where uploaded files are written — public/ is served statically, private/
# never is. Defaults to ./storage if unset.
STORAGE_ROOT=storage
