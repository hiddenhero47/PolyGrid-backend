# Copy this to .env and fill in real values.

NODE_ENV=development
PORT=4000
MONGO_URI=
BASE_URL=http://localhost:4000

JWT_SECRET=
JWT_EMAIL_SECRET=
# Signs the short-lived ?token= on /private/view|download URLs — kept
# separate from JWT_SECRET so a leaked one can't forge a login session.
FILE_SIGNING_SECRET=

APP_NAME=PolyGrid
FRONTEND_URL=http://localhost:5173

# OAuth login — the "audience" each provider checks an id/identity token
# against. GOOGLE_CLIENT_ID is a Google Cloud OAuth client id;
# APPLE_CLIENT_ID is your Sign in with Apple Services ID.
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# Where uploaded files are written — public/ is served statically, private/
# never is. Defaults to ./storage if unset.
STORAGE_ROOT=storage

# PolyGrid's cut of a job's payment, as a percentage (0-100). Snapshotted
# onto each job at creation, so changing this later doesn't affect existing
# jobs. Defaults to 0 if unset.
PLATFORM_FEE_PERCENT=5

# Stripe — get both from your Stripe Dashboard (test mode keys start with
# sk_test_/whsec_...). STRIPE_WEBHOOK_SECRET signs/verifies
# POST /api/payments/stripe/webhook; get it from `stripe listen
# --print-secret` for local testing, or your Dashboard's webhook endpoint
# config for a deployed one.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Mailgun — transactional email (password reset, refund/payout request
# decisions). Get these from your Mailgun Dashboard; EMAIL_FROM is the
# "From" address shown to recipients, usually something@your-verified-
# mailgun-domain.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
EMAIL_FROM=

# Which backend stores digital product deliverables and each buyer's
# purchase-time snapshot copy (see docs/digital-storefront-plan.md):
# "internal" (local disk under STORAGE_ROOT/digital-store/, the default —
# no AWS account needed) or "aws" (S3, requires the AWS_* vars below).
# Deliberately a deploy-time setting only — edit this and redeploy, never
# exposed through any API — switching providers while files already exist
# would leave old files pointing at whichever store they were actually
# written to while new reads looked in the other one.
DIGITAL_STORAGE_PROVIDER=internal

# AWS S3 — only read when DIGITAL_STORAGE_PROVIDER=aws. Get these from
# IAM; the bucket's policy needs PutObject/GetObject/CopyObject/
# DeleteObject on digital-products/* and digital-purchases/*.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=
